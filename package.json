{
  "name": "@alexdochioiu/pi-openai-fast",
  "version": "1.2.1",
  "description": "OpenAI fast mode toggle for pi - Enables priority service tier on supported GPT-5 models and sends codex CLI headers",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "openai",
    "codex",
    "gpt-5.4",
    "gpt-5.5",
    "gpt-5.6",
    "fast",
    "priority",
    "service-tier"
  ],
  "type": "module",
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexDochioiu/pi-openai-fast.git"
  },
  "author": "AlexDochioiu (forked from Ben Vargas)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AlexDochioiu/pi-openai-fast/issues"
  },
  "homepage": "https://github.com/AlexDochioiu/pi-openai-fast#readme"
}
